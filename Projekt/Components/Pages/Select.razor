@page "/select"
@using Projekt.Models
@using Projekt.Data
@using Microsoft.EntityFrameworkCore
@inject AppDbContext DbContext

<PageTitle>Select *</PageTitle>

<div class="min-h-screen bg-gray-50 py-10 px-4">
    <div class="max-w-[1600px] mx-auto">
        
        <header class="text-center mb-12">
            <h1 class="text-4xl font-black text-slate-900 tracking-tight uppercase italic">
                Etap 1 Select *
            </h1>
            
        </header>

        @if (cards == null)
        {
            <div class="flex justify-center mt-20">
                <div class="animate-spin rounded-full h-12 w-12 border-t-4 border-indigo-600"></div>
            </div>
        }
        else if (!cards.Any())
        {
            <div class="text-center p-20 bg-white rounded-3xl shadow-sm border border-dashed border-slate-300">
                <p class="text-slate-400 text-lg">Twój klaser jest jeszcze pusty...</p>
            </div>
        }
        else
        {
        
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 2xl:grid-cols-7 gap-4">
                @foreach (var card in cards)
                {
                    <div class="group relative aspect-[5/7] rounded-xl overflow-hidden shadow-sm hover:shadow-2xl transition-all duration-500 hover:-translate-y-2 cursor-pointer bg-white border border-slate-200">
                        
               
                        <div class="absolute top-2 right-2 z-20 bg-black/60 backdrop-blur-md text-white text-[10px] px-2 py-0.5 rounded-full font-bold opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                            #@card.CardNumber
                        </div>

                       
                        <div class="w-full h-full bg-slate-100 flex items-center justify-center overflow-hidden">
                            <img src="@card.ImageUrl" 
                                 class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-in-out" 
                                 alt="@card.Name" />
                       </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private List<Card>? cards;

    protected override async Task OnInitializedAsync()
    {
        cards = await DbContext.Cards.ToListAsync();
    }
}